{
  "schemaVersion": "1.0.0",
  "configVersion": "FA@1.0.0",
  "code": "FA",
  "name": "Facial Activation",
  "biomarkers": "TBD",
  "sides": [],
  "minTier": "B",
  "trackers": ["face"],
  "camera": {
    "facing": "back",
    "resolution": "1080p",
    "targetFps": 30,
    "minEffectiveFps": 29,
    "orientation": "portrait",
    "lock": { "ae": true, "af": true, "awb": true }
  },
  "analysis": { "fps": 30 },
  "setup": {
    "view": "frontal_face",
    "distanceM": [0.4, 0.6],
    "heightRef": "eye",
    "checklist": ["phone_on_stand", "light_in_front", "hair_off_face"]
  },
  "framing": {
    "overlay": "face_oval",
    "requiredLandmarks": { "face": "ALL" },
    "safeZoneMargin": 0.05,
    "subjectSize": { "metric": "face_height", "min": 0.35, "max": 0.65 },
    "singlePerson": true,
    "maxFaceAngleDeg": { "yaw": 10, "pitch": 10 }
  },
  "task": {
    "detector": "expression_sequence",
    "durationS": 15,
    "noMotionTimeoutS": 5,
    "detectorParams": "TBD"
  },
  "verdict": {
    "minLandmarkVisibleFrac": 0.98,
    "durationToleranceS": 0.1,
    "maxCriticalEvents": 0,
    "sharpness": "DEVICE_CALIBRATED"
  },
  "instructions": { "demoVideo": "TBD", "stepKeys": ["fa.step1", "fa.step2"] }
}
