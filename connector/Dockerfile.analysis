# syntax=docker/dockerfile:1
# The hospital connector with biomarker analysis (M15, decision 059): the connector image plus the
# analysis package (MediaPipe, SciPy) and its models. Build from the repo root:
#   docker build -f connector/Dockerfile.analysis -t neurocapture-connector:analysis .
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 NCBIO_CONFIG_DIR=/srv/config NCBIO_MODELS_DIR=/srv/models
# MediaPipe needs EGL/GLES even on the CPU.
RUN apt-get update && apt-get install -y --no-install-recommends libegl1 libgles2 && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY config/analysis.json config/biomarker-registry.json ./config/
COPY config/messages/report.en.json ./config/messages/
COPY biomarkers/pyproject.toml ./biomarkers/
COPY biomarkers/ncbio ./biomarkers/ncbio
COPY connector/pyproject.toml ./
COPY connector/ncconnector ./ncconnector
COPY connector/sql ./sql
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -f /run/secrets/extra_ca ]; then export PIP_CERT=/run/secrets/extra_ca; fi; \
    pip install --no-cache-dir . ./biomarkers && python -m ncbio models \
    && useradd --system --uid 10002 connector && mkdir -p /data && chown connector /data
USER connector
EXPOSE 8100
HEALTHCHECK --interval=10s --timeout=3s CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8100/health').status==200 else 1)"
CMD ["uvicorn", "ncconnector.main:app", "--host", "0.0.0.0", "--port", "8100"]
