{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurocapture.local/contracts/biomarker-registry.schema.json",
  "title": "BiomarkerRegistry",
  "description": "Biomarker IDs and their input requirements (DEV_PLAN §10, M8). formula stays null until defined. Schema version 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryVersion", "biomarkers"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "registryVersion": { "type": "string", "pattern": "^REG@[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "biomarkers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "testCode", "family", "formula", "formulaVersion", "inputs"],
        "properties": {
          "id": { "type": "string", "pattern": "^(FT|FTF|FR|SAW|FA)[0-9]+$" },
          "testCode": { "enum": ["FT", "FTF", "FR", "SAW", "FA"] },
          "family": { "type": "string", "minLength": 1 },
          "formula": { "type": ["string", "null"] },
          "formulaVersion": { "type": ["string", "null"] },
          "inputs": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "minEffectiveFps": { "type": "number", "exclusiveMinimum": 0 },
              "minDurationS": { "type": "number", "exclusiveMinimum": 0 },
              "trackers": { "type": "array", "items": { "enum": ["hand", "pose", "face"] } },
              "landmarks": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "integer", "minimum": 0 } } },
              "minLandmarkVisibleFrac": { "type": "number", "minimum": 0, "maximum": 1 },
              "requiresSensors": { "type": "boolean" },
              "requiresPhases": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
