{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurocapture.local/contracts/landmarks-header.schema.json",
  "title": "LandmarksHeader",
  "description": "JSON header of landmarks.bin (DEV_PLAN \u00a712.2). File layout: 4-byte magic 'NCLM', uint32 LE header length, UTF-8 JSON header, then records, each: uint32 LE byte length of the rest, then the record body (layout 'NCLM-v1', see packages/capture-kit/src/landmarks.ts). Schema version 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "coordinateSystem",
    "orientation",
    "mirrored",
    "timestampSemantics",
    "clockSource",
    "record",
    "trackers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "coordinateSystem": {
      "const": "normalized_upright_analysis_frame"
    },
    "orientation": {
      "enum": ["portrait", "landscape"]
    },
    "mirrored": {
      "type": "boolean"
    },
    "timestampSemantics": {
      "const": "camera_frame_canonical_elapsed_realtime_ns"
    },
    "clockSource": {
      "enum": ["REALTIME", "UNKNOWN", "SIMULATED"]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endianness", "dtype"],
      "properties": {
        "endianness": {
          "const": "little"
        },
        "dtype": {
          "const": "float32"
        }
      }
    },
    "trackers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "modelVersion", "pointsPerFrame", "valuesPerPoint"],
        "properties": {
          "name": {
            "enum": ["hand", "pose", "face"]
          },
          "modelVersion": {
            "type": "string",
            "minLength": 1
          },
          "pointsPerFrame": {
            "enum": [21, 33, 478]
          },
          "valuesPerPoint": {
            "enum": [3, 4]
          }
        }
      }
    },
    "layout": {
      "const": "NCLM-v1"
    },
    "takeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "handednessLabels": {
      "description": "Records store MediaPipe's raw label. On an un-mirrored image it names the subject's hand; when imageMirrored is true readers flip it (decision 012).",
      "const": "mediapipe_raw"
    },
    "imageMirrored": {
      "type": "boolean",
      "description": "Whether the analysis image given to the trackers was mirrored."
    },
    "blendshapeNames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "description": "Analysis image size in pixels (upright), so readers can restore aspect-dependent geometry (M8 replay). Optional for files written before plugin 0.9.0.",
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
