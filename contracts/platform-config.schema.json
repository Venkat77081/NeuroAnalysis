{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurocapture.local/contracts/platform-config.schema.json",
  "title": "PlatformConfig",
  "description": "Account and invite policy for hospitals, staff, operators and patients (PLATFORM_PLAN M10). Schema version 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "configVersion",
    "invites",
    "passwords",
    "patientPin",
    "staff",
    "consentVersion",
    "defaultPlan",
    "app",
    "operators",
    "requests",
    "permissions",
    "deviceCheck",
    "appointmentChanges",
    "clinicConsent",
    "connectorHealth"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "configVersion": {
      "type": "string",
      "pattern": "^PLATFORM@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "invites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patientTtlDays",
        "staffTtlDays",
        "deviceCodeTtlHours",
        "deviceCodeLength",
        "deviceQrPrefix"
      ],
      "properties": {
        "patientTtlDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "staffTtlDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "deviceCodeTtlHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "deviceCodeLength": {
          "type": "integer",
          "minimum": 8,
          "maximum": 16
        },
        "deviceQrPrefix": {
          "type": "string",
          "pattern": "^[a-z0-9]+:$",
          "description": "v29 (decision 052): the clinic-phone registration QR holds this prefix + the code; the phone scans it on set-up."
        }
      }
    },
    "passwords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minLength", "temporaryLength"],
      "properties": {
        "minLength": {
          "type": "integer",
          "minimum": 8,
          "maximum": 64
        },
        "temporaryLength": {
          "type": "integer",
          "minimum": 10,
          "maximum": 32
        }
      }
    },
    "patientPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minDigits", "maxDigits", "maxFailures"],
      "properties": {
        "minDigits": {
          "type": "integer",
          "minimum": 4,
          "maximum": 8
        },
        "maxDigits": {
          "type": "integer",
          "minimum": 4,
          "maximum": 8
        },
        "maxFailures": {
          "type": "integer",
          "minimum": 3,
          "maximum": 10
        }
      }
    },
    "staff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["twoStepRequired", "maxFailedLogins", "resetTtlHours", "resetReasons"],
      "properties": {
        "twoStepRequired": {
          "type": "boolean"
        },
        "maxFailedLogins": {
          "type": "integer",
          "minimum": 3,
          "maximum": 20
        },
        "resetTtlHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72,
          "description": "Staff sign-in reset link lifetime (decision 039)."
        },
        "resetReasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "description": "Reasons an admin picks when resetting someone's sign-in (kept in the log)."
        }
      }
    },
    "consentVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "defaultPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "everyDays", "medState"],
      "description": "Recording plan for a patient until their doctor sets one (M13).",
      "properties": {
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["FT", "FTF", "FR", "SAW", "FA"]
          }
        },
        "everyDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "medState": {
          "enum": ["OFF", "ON", "ANY"]
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatorAutoLockMin", "patientAutoLockMin", "homeSawNeedsHelper"],
      "properties": {
        "operatorAutoLockMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "patientAutoLockMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "homeSawNeedsHelper": {
          "type": "boolean",
          "description": "Home walking test only with a helper holding the phone."
        }
      }
    },
    "operators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFailedLogins"],
      "description": "Clinic operators (M13): wrong passwords in a row before the account locks; a hospital admin unlocks it.",
      "properties": {
        "maxFailedLogins": {
          "type": "integer",
          "minimum": 3,
          "maximum": 20
        }
      }
    },
    "requests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultDueDaysBefore",
        "rerecordDueDays",
        "reminderHoursBefore",
        "appointmentWindowDays",
        "clinicNotDoneReasons",
        "clinicQueueMaxHours"
      ],
      "description": "Recording requests for appointments (v3): when they are due, re-record deadline, reminder lead time, how far ahead reception sees appointments.",
      "properties": {
        "defaultDueDaysBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14
        },
        "rerecordDueDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "reminderHoursBefore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "appointmentWindowDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "clinicNotDoneReasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "description": "Why an operator could not record a clinic request (codes; texts are in the app's i18n)."
        },
        "clinicQueueMaxHours": {
          "type": "integer",
          "minimum": 12,
          "maximum": 168,
          "description": "Longest time window a clinic phone may ask the queue for."
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "Per-hospital permissions (decision 033): what each role may do by default, and which roles a platform admin may grant it to. Clinical data, patient identity, consent and logging are fixed in code and are not listed here.",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]+\\.[a-z]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["group", "default", "eligible"],
          "properties": {
            "group": {
              "enum": ["patients", "appointments", "requests", "clinic", "setup"]
            },
            "default": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["hospital_admin", "receptionist", "doctor", "operator"]
              }
            },
            "eligible": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["hospital_admin", "receptionist", "doctor", "operator"]
              }
            }
          }
        }
      }
    },
    "deviceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minFps",
        "warnBelowFps",
        "durationS",
        "facing",
        "resolution",
        "usageDays",
        "minFpsOptions"
      ],
      "description": "Camera check before a phone is added (user, 16 Nov 2026): clinic phones before their registration code is used, patients before their invite is accepted.",
      "properties": {
        "minFps": {
          "type": "number",
          "minimum": 30,
          "maximum": 60
        },
        "warnBelowFps": {
          "type": "number",
          "minimum": 30,
          "maximum": 60,
          "description": "Passed but below this: 'borderline', some takes may need repeating (takes fail below the session minimum, 59 by default)."
        },
        "durationS": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "facing": {
          "enum": ["back", "front"]
        },
        "resolution": {
          "enum": ["1080p", "720p"]
        },
        "usageDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "Phones list: takes recorded on each phone over this many days, and how many were below warnBelowFps."
        },
        "minFpsOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 30,
            "maximum": 60
          },
          "description": "Pass levels a hospital admin may choose for its phones (v13); the lowest is minFps. A hospital can be stricter, never looser."
        }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "description": "v10 Overview pages (decision 042): time windows for the cards and the chart.",
      "required": [
        "periodsDays",
        "recentDays",
        "inviteDays",
        "deskDays",
        "doctorUpcomingDays",
        "onTimeDays"
      ],
      "properties": {
        "periodsDays": {
          "type": "object",
          "additionalProperties": false,
          "required": ["4w", "12w", "1y"],
          "properties": {
            "4w": {
              "type": "integer",
              "minimum": 7,
              "maximum": 730
            },
            "12w": {
              "type": "integer",
              "minimum": 7,
              "maximum": 730
            },
            "1y": {
              "type": "integer",
              "minimum": 7,
              "maximum": 730
            }
          },
          "description": "Chart periods offered (days back, counted per week)."
        },
        "recentDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "'Recordings (30 days)', 'not used in 30 days', 'onboarded this month'."
        },
        "inviteDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90,
          "description": "Front desk: invites sent and patients not in the app with an appointment within this many days."
        },
        "deskDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 90,
          "description": "Front desk chart: appointments per day for the next N days."
        },
        "doctorUpcomingDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "onTimeDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 365,
          "description": "Doctor: home links recorded by their due date over this many days."
        }
      }
    },
    "appAccount": {
      "type": "object",
      "additionalProperties": false,
      "description": "v11 patient app account (decision 043): e-mail codes, PIN pause, recovery code length. Wrong PINs use patientPin.maxFailures.",
      "required": [
        "codeTtlMinutes",
        "codeMaxPerHour",
        "codeMaxAttempts",
        "pauseHours",
        "recoveryCodeChars"
      ],
      "properties": {
        "codeTtlMinutes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 60
        },
        "codeMaxPerHour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "codeMaxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "pauseHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "recoveryCodeChars": {
          "type": "integer",
          "enum": [24]
        }
      }
    },
    "appointmentChanges": {
      "type": "object",
      "additionalProperties": false,
      "description": "v13/v14: appointment changes and booking from the app. Patients ask for exact free times (preferred and alternative dates) to change or book; the desk books one, offers up to offerMax held times, or declines; both sides may cancel with a reason; recordings follow a moved appointment (recordingValidDays).",
      "required": [
        "cutoffHours",
        "cutoffHourOptions",
        "maxDays",
        "maxDaysAhead",
        "patientReasons",
        "declineAnswers",
        "deskReasons",
        "answerShownDays",
        "movedShownDays",
        "undoSeconds",
        "slotMinutes",
        "slotMinuteOptions",
        "timeZones",
        "defaultTimeZone",
        "bookingPreferred",
        "bookingPreferredOptions",
        "bookingAlternatives",
        "bookingAlternativeOptions",
        "timesPerDate",
        "timesPerDateOptions",
        "bookingDaysAhead",
        "bookingDaysAheadOptions",
        "bookingMinDays",
        "bookingMinDayOptions",
        "offerMax",
        "offerMaxOptions",
        "offerReplyHours",
        "offerReplyHourOptions",
        "recordingValidDays",
        "recordingValidDayOptions",
        "recordDueDaysBeforeOptions",
        "cancelReasons",
        "patientCancelReasons",
        "bookingPurposes",
        "bookingDeclineAnswers",
        "cancelledShownDays",
        "patientHistoryMax",
        "freeDaysMaxSpan"
      ],
      "properties": {
        "cutoffHours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 336,
          "description": "Default: patients may ask until this many hours before the appointment (a hospital admin can change it)."
        },
        "cutoffHourOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 336
          }
        },
        "maxDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "maxDaysAhead": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "patientReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        },
        "declineAnswers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        },
        "deskReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        },
        "answerShownDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90
        },
        "movedShownDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90
        },
        "undoSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "v29 (decision 052): how long the dashboard holds a desk change (book, move, offer, cancel, did not come) so it can be undone before anything is sent; 0 = sent at once."
        },
        "slotMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "slotMinuteOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 5,
            "maximum": 120
          }
        },
        "timeZones": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Default time zone by hospital region; a hospital admin can change it."
        },
        "defaultTimeZone": {
          "type": "string"
        },
        "bookingPreferred": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "bookingPreferredOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        },
        "bookingAlternatives": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "bookingAlternativeOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "timesPerDate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "timesPerDateOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        },
        "bookingDaysAhead": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "bookingDaysAheadOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          }
        },
        "bookingMinDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "bookingMinDayOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          }
        },
        "offerMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "offerMaxOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "offerReplyHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 336
        },
        "offerReplyHourOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 336
          }
        },
        "recordingValidDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "recordingValidDayOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          }
        },
        "recordDueDaysBeforeOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          }
        },
        "cancelReasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        },
        "patientCancelReasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        },
        "bookingPurposes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        },
        "bookingDeclineAnswers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        },
        "cancelledShownDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90
        },
        "patientHistoryMax": {
          "description": "v17: past appointments shown in the patient app's Appointment history.",
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "freeDaysMaxSpan": {
          "description": "v17: most days one calendar request may ask free-time counts for.",
          "type": "integer",
          "minimum": 7,
          "maximum": 120
        }
      }
    },
    "connectorHealth": {
      "type": "object",
      "additionalProperties": false,
      "description": "v29 (decision 052): the hospital connector checks in with the platform every heartbeatSeconds; it counts as offline after offlineAfterMinutes without one. Dashboards show the last historyHours, one bar per hour; hourly counts are kept for keepDays.",
      "required": ["heartbeatSeconds", "offlineAfterMinutes", "historyHours", "keepDays"],
      "properties": {
        "heartbeatSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "offlineAfterMinutes": { "type": "integer", "minimum": 2, "maximum": 1440 },
        "historyHours": { "type": "integer", "minimum": 6, "maximum": 168 },
        "keepDays": { "type": "integer", "minimum": 1, "maximum": 365 }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "description": "v31: with the Automatic appearance, dashboards (and later the app) use their dark colours from darkFromHour until lightFromHour, local time.",
      "required": ["darkFromHour", "lightFromHour"],
      "properties": {
        "darkFromHour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "lightFromHour": { "type": "integer", "minimum": 0, "maximum": 23 }
      }
    },
    "clinicConsent": {
      "type": "object",
      "additionalProperties": false,
      "description": "v16 (decision 047): clinic recordings need the patient's consent, given in their app and shown as a one-time QR code (prefix + code) the clinic phone scans; or, when the hospital allows it, on the clinic phone with a reason.",
      "required": ["qrPrefix", "codeLength", "fallbackReasons"],
      "properties": {
        "qrPrefix": {
          "type": "string",
          "pattern": "^[a-z0-9]+:$"
        },
        "codeLength": {
          "type": "integer",
          "minimum": 10,
          "maximum": 32
        },
        "fallbackReasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        }
      }
    }
  }
}
