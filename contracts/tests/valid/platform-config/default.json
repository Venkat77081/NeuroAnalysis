{
  "schemaVersion": "1.0.0",
  "configVersion": "PLATFORM@1.6.0",
  "invites": {
    "patientTtlDays": 7,
    "staffTtlDays": 7,
    "deviceCodeTtlHours": 24,
    "deviceCodeLength": 10
  },
  "passwords": {
    "minLength": 10,
    "temporaryLength": 14
  },
  "patientPin": {
    "minDigits": 4,
    "maxDigits": 6,
    "maxFailures": 5
  },
  "staff": {
    "twoStepRequired": true,
    "maxFailedLogins": 10,
    "resetTtlHours": 24,
    "resetReasons": ["forgot_password", "lost_phone", "misuse"]
  },
  "consentVersion": "home-consent@1",
  "defaultPlan": {
    "tests": ["FT", "FTF", "FR", "SAW", "FA"],
    "everyDays": 7,
    "medState": "OFF"
  },
  "app": {
    "operatorAutoLockMin": 5,
    "patientAutoLockMin": 2,
    "homeSawNeedsHelper": true
  },
  "operators": {
    "maxFailedLogins": 10
  },
  "requests": {
    "defaultDueDaysBefore": 1,
    "rerecordDueDays": 3,
    "reminderHoursBefore": 24,
    "appointmentWindowDays": 7,
    "clinicNotDoneReasons": ["did_not_attend", "unwell", "refused", "no_time", "other"],
    "clinicQueueMaxHours": 48
  },
  "permissions": {
    "patients.search": {
      "group": "patients",
      "default": ["receptionist"],
      "eligible": ["hospital_admin", "receptionist", "doctor"]
    },
    "invites.send": {
      "group": "patients",
      "default": ["receptionist"],
      "eligible": ["hospital_admin", "receptionist", "doctor"]
    },
    "appointments.view": {
      "group": "appointments",
      "default": ["receptionist", "doctor"],
      "eligible": ["hospital_admin", "receptionist", "doctor"]
    },
    "appointments.add": {
      "group": "appointments",
      "default": ["receptionist"],
      "eligible": ["hospital_admin", "receptionist", "doctor"]
    },
    "appointments.assign": {
      "group": "appointments",
      "default": ["receptionist"],
      "eligible": ["hospital_admin", "receptionist", "doctor"]
    },
    "requests.send": {
      "group": "requests",
      "default": ["doctor"],
      "eligible": ["doctor"]
    },
    "requests.rerecord": {
      "group": "requests",
      "default": ["doctor"],
      "eligible": ["doctor"]
    },
    "clinic.record": {
      "group": "clinic",
      "default": ["operator"],
      "eligible": ["operator"]
    },
    "setup.team": {
      "group": "setup",
      "default": ["hospital_admin"],
      "eligible": ["hospital_admin", "receptionist", "doctor"]
    },
    "setup.phones": {
      "group": "setup",
      "default": ["hospital_admin"],
      "eligible": ["hospital_admin", "receptionist", "doctor"]
    },
    "setup.connections": {
      "group": "setup",
      "default": ["hospital_admin"],
      "eligible": ["hospital_admin", "receptionist", "doctor"]
    },
    "setup.activity": {
      "group": "setup",
      "default": ["hospital_admin"],
      "eligible": ["hospital_admin", "receptionist", "doctor"]
    },
    "setup.settings": {
      "group": "setup",
      "default": ["hospital_admin"],
      "eligible": ["hospital_admin"]
    }
  },
  "deviceCheck": {
    "minFps": 55,
    "warnBelowFps": 59,
    "durationS": 20,
    "facing": "back",
    "resolution": "1080p",
    "usageDays": 30,
    "minFpsOptions": [55, 56, 57, 58, 59]
  },
  "overview": {
    "periodsDays": {
      "4w": 28,
      "12w": 84,
      "1y": 365
    },
    "recentDays": 30,
    "inviteDays": 7,
    "deskDays": 14,
    "doctorUpcomingDays": 30,
    "onTimeDays": 90
  },
  "appAccount": {
    "codeTtlMinutes": 10,
    "codeMaxPerHour": 5,
    "codeMaxAttempts": 5,
    "pauseHours": 24,
    "recoveryCodeChars": 24
  },
  "appointmentChanges": {
    "cutoffHours": 24,
    "cutoffHourOptions": [2, 4, 12, 24, 48, 72],
    "maxDays": 3,
    "maxDaysAhead": 90,
    "patientReasons": ["cant_make_it", "unwell", "travel", "other"],
    "declineAnswers": ["call_us", "keep"],
    "deskReasons": [
      "doctor_unavailable",
      "patient_called",
      "clinic_change",
      "patient_request",
      "patient_choice",
      "other"
    ],
    "answerShownDays": 14,
    "movedShownDays": 7,
    "slotMinutes": 15,
    "slotMinuteOptions": [10, 15, 20, 30, 45, 60],
    "timeZones": {
      "IN": "Asia/Kolkata",
      "US": "America/New_York"
    },
    "defaultTimeZone": "UTC",
    "bookingPreferred": 2,
    "bookingPreferredOptions": [1, 2, 3],
    "bookingAlternatives": 2,
    "bookingAlternativeOptions": [0, 1, 2, 3],
    "timesPerDate": 2,
    "timesPerDateOptions": [1, 2, 3],
    "bookingDaysAhead": 60,
    "bookingDaysAheadOptions": [14, 30, 60, 90],
    "bookingMinDays": 2,
    "bookingMinDayOptions": [0, 1, 2, 3, 7],
    "offerMax": 3,
    "offerMaxOptions": [1, 2, 3],
    "offerReplyHours": 48,
    "offerReplyHourOptions": [12, 24, 48, 72],
    "recordingValidDays": 14,
    "recordingValidDayOptions": [7, 14, 21, 30],
    "recordDueDaysBeforeOptions": [0, 1, 2, 3],
    "cancelReasons": [
      "patient_asked",
      "doctor_unavailable",
      "clinic_closed",
      "booked_by_mistake",
      "other"
    ],
    "patientCancelReasons": ["feeling_better", "cant_make_it", "going_elsewhere", "other"],
    "bookingPurposes": ["follow_up", "symptoms_changed", "medicine_review", "other"],
    "bookingDeclineAnswers": ["fully_booked", "needs_referral", "wrong_clinic", "call_us"],
    "cancelledShownDays": 14
  }
}
