{
  "name": "@neurocapture/capture-kit",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "CaptureKit Capacitor plugin: TS contract, MockCaptureKit, (later) native Android/iOS.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "fixture:gen": "tsx scripts/make-sample-fixture.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "golden:gen": "tsx scripts/make-golden-streams.ts && tsx scripts/make-golden-landmarks.ts"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@neurocapture/contracts-ts": "workspace:*",
    "@neurocapture/quality-core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "files": [
    "src",
    "android/src",
    "android/build.gradle",
    "fixtures"
  ]
}
